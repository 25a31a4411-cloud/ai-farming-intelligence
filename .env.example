# Supabase browser configuration. Use the project URL and publishable key.
# Legacy anon keys are supported as a compatibility alternative.
# Never place a service-role key or database password in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy key name if your Supabase project still uses the anon key:
# VITE_SUPABASE_ANON_KEY=
